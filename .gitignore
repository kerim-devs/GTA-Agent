lab/blips/*-scenes-*.jpg

# Fetch with pilot/tools/fetch_models.py (20 MB).
pilot/models/*.onnx
pilot/models/*.pth

# contact sheets rebuilt by lab/hud/prepare.py, 15 MB
lab/hud/review/

# single frames rebuilt by pilot/tools/inspect_flow_clips.py, 65 MB; the contact sheets stay
lab/flow/*/[0-9]*.jpg
!lab/flow/failure/0038.030-856.jpg

# rebuilt by pilot/tools/sim_waypoint.py, 4 MB
lab/waypoint/simulation.json

# speech files rebuilt by pilot/tools/commentator_replay.py
lab/commentator/**/*.wav

# sheets rebuilt by pilot/tools/evaluate_objects.py, 42 MB; the three the report and its review show stay
lab/objects/p14b/sheets/
lab/objects/holdout/sheets/*
!lab/objects/holdout/sheets/labelled-004.jpg
!lab/objects/holdout/sheets/labelled-008.jpg
!lab/objects/holdout/sheets/labelled-040.jpg

# Regenerated P22 replay frames and detailed runtime logs.
/lab/wiring/replay*/
/lab/wiring/simulations/
/lab/wiring/mutations/
/lab/wiring/replay*-command.log

# Console calibration sessions and reproducible extraction scratch files.
/lab/calibrate/*/

# P25 reproducible intermediate crops and console output.
lab/wanted/scratch/
lab/wanted/*.log

/lab/commentator/p20c-*/

# Generated cable-screen contact sheets and scan caches.
lab/screens/review/

# drawn from the recordings by lab/judge/sample.py, 36 MB
lab/judge/sample/

# rebuilt by lab/sections/contact.py, 30 MB
lab/sections/contact/

# the judge answers of lab/sections, rebuilt by tools/sections.py --judge, about 100 KB each
lab/sections/out/*/judge.json
lab/sections/judged/*/judge.json
# rebuilt by lab/notes/contact_sheets.py, 44 MB; raw readings rebuilt by pilot/tools/texts.py
lab/notes/contact-*/
lab/notes/out/*/readings.jsonl

# HUD and minimap readings at 10 Hz, rebuilt by pilot/tools/incidents.py, 17 MB; contact sheets of
# the incident check, rebuilt by lab/notes/incident_sheets.py from incidents-check/*.jsonl
lab/notes/out/*/hud.jsonl
lab/notes/incidents-check/sheets/
lab/notes/incidents-check/overview/
# action labels and their index, rebuilt by lab/actions/process-new.sh, about 15 MB; summary.md stays
lab/actions/out/*
!lab/actions/out/summary.md
# contact sheets rebuilt by lab/actions/sheets.py
lab/actions/sheets/
# rebuilt by pilot/tools/human_drive.py, 110 MB
lab/human-drive/out/*/drive.json
lab/human-drive/out/*/readings-v3.jsonl
